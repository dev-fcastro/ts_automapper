{
  "name": "ts_automapper",
  "version": "0.0.0-semantically-released",
  "description": "Librería TypeScript inspirada en AutoMapper de C# para mapear objetos de forma sencilla y tipada.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-esm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "typescript",
    "automapper",
    "object-mapper",
    "mapping",
    "open-source",
    "dto",
    "mapper"
  ],
  "author": "Francisco Daniel Castro Borrome",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-fcastro/ts_automapper.git"
  },
  "bugs": {
    "url": "https://github.com/dev-fcastro/ts_automapper/issues"
  },
  "homepage": "https://github.com/dev-fcastro/ts_automapper#readme",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
